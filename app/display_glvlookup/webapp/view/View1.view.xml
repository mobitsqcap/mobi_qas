<mvc:View
    controllerName="displayglvlookup.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:u="sap.ui.unified"
    xmlns="sap.m"
>
  <Page id="page">
<!--  Header  -->
<customHeader>
<Bar>
<!--  MOBI Logo  -->
<contentLeft>
<Image src="images/mobi-logo.png" width="130px" height="55px" decorative="false" alt="MOBI Logo"/>
</contentLeft>
<!--  Empty Middle  -->
<contentMiddle/>
<!--  Right Buttons  -->
<contentRight>
<Button text="Download Template" icon="sap-icon://download" press="onDownload"/>
<Button icon="sap-icon://sys-help" tooltip="Help" press="onHelp"/>
</contentRight>
</Bar>
</customHeader>
<!--  Page Content  -->
<content>
<VBox width="100%" class="sapUiMediumMargin">
<!--  File Upload  -->
<HBox width="80%" justifyContent="SpaceBetween" alignItems="Center" class="sapUiMediumMarginBottom">
<u:FileUploader id="fileUploader" width="350px" placeholder="Choose Excel File" buttonText="Browse" fileType="xlsx,xls" uploadOnChange="false" sameFilenameAllowed="true" change="onUpload"/>
<Button id="btnHanaPush" text="Upload Data" type="Emphasized" press="onhanapush" enabled="false" icon="sap-icon://upload-to-cloud"/>
</HBox>
<MessageStrip id="recordSummary" visible="false" type="Success" showCloseButton="false" text="" class="sapUiSmallMarginBottom"/>
<MessageStrip id="uploadSummary" visible="false" type="Information" showCloseButton="false" text="" class="sapUiSmallMarginBottom"/>
<ScrollContainer width="100%" height="600px" horizontal="true" vertical="true">
<!--  Excel Data Table  -->
<Table id="idTable" width="1200px" fixedLayout="true" inset="false" growing="true" growingScrollToLoad="true" items="{tableModel>/data}">
<columns>
<Column>
<Text text="Company Code"/>
</Column>
<Column>
<Text text="Payment Type"/>
</Column>
<Column>
<Text text="Payment Sub Type"/>
</Column>
<Column>
<Text text="Host"/>
</Column>
<Column>
<Text text="Transaction Amount"/>
</Column>
<Column>
<Text text="Host MDR Amount"/>
</Column>
<Column>
<Text text="Host Fee Payable"/>
</Column>
<Column>
<Text text="Mobi MDR Amount"/>
</Column>
<Column>
<Text text="MDR Revenue"/>
</Column>
<Column>
<Text text="GL Accounts"/>
</Column>
<Column>
<Text text="Status"/>
</Column>
</columns>
<items>
<ColumnListItem highlight="{tableModel>rowHighlight}">
<cells>
<Text text="{tableModel>Company Code}"/>
<Text text="{tableModel>Payment Type}"/>
<Text text="{tableModel>Payment Sub Type}"/>
<Text text="{tableModel>Host}"/>
<Text text="{tableModel>transaction_amount}"/>
<Text text="{tableModel>host_mdr_amount}"/>
<Text text="{tableModel>host_fee_payable}"/>
<Text text="{tableModel>mobi_mdr_amount}"/>
<Text text="{tableModel>mdr_revenue}"/>
<Text text="{tableModel>GL Accounts}"/>
<Text text="{tableModel>Status}"/>
</cells>
</ColumnListItem>
</items>
</Table>
</ScrollContainer>
</VBox>
</content>
</Page>
</mvc:View>
